+        assertTrue(f.seen.contains("e1:u1"), "dedupe key is eventId + ':' + userId");
+    }
+
+    @Test @DisplayName("quiet hours: NORMAL and BULK are deferred (per channel) and not sent")
+    void quietHoursDefers() {
