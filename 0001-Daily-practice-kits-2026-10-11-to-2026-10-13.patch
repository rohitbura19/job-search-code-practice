+        e.setEventId("evt-1"); e.setChargerId("CH-7"); e.setStatus(ChargerEvent.Status.CHARGING);
+        e.setKwh(12.5); e.setEventTime(Instant.parse("2026-10-11T10:00:00Z"));
+        return e;
